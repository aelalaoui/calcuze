# .htaccess pour Calcuze - Optimisation SEO
# VERSION 3.0 - Corrections complètes d'indexation Google
# Redirections : HTTP→HTTPS, www→non-www, trailing slash, params lang/country

# Activer le module de réécriture
RewriteEngine On

# ============================================================================
# BLOC 1 : HTTPS + non-www EN UNE SEULE RÈGLE (évite les chaînes de redirections)
# Couvre tous les cas : http/https + www/non-www → https://calcuze.com
# ============================================================================

# Cas 1 : HTTP avec www → HTTPS sans www (une seule redirection)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Cas 2 : HTTP sans www → HTTPS sans www
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Cas 3 : HTTPS avec www → HTTPS sans www
RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ============================================================================
# BLOC 2 : REDIRECTIONS DES ANCIENNES URLs avec paramètres (AVANT les autres règles)
# /?lang=es&country=MX → /es/MX (301)
# ============================================================================

# Paramètres lang + country → nouvelle structure /lang/COUNTRY
RewriteCond %{QUERY_STRING} ^lang=([a-z]{2})&country=([A-Z]{2})$ [NC]
RewriteRule ^$ /%1/%2? [R=301,L]

# Paramètre lang seul → /lang/XX (fallback US)
RewriteCond %{QUERY_STRING} ^lang=([a-z]{2})$ [NC]
RewriteRule ^$ /%1/US? [R=301,L]

# ============================================================================
# BLOC 3 : REDIRECTIONS DES PAGES SPÉCIFIQUES
# ============================================================================

# index.html → / (racine, 301 permanent)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# index.php (requête directe) → / (racine, 301 permanent)
RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# contact.html → /contact (301 permanent)
RewriteCond %{THE_REQUEST} \s/contact\.html[\s?] [NC]
RewriteRule ^contact\.html$ /contact [R=301,L]

# contact?lang=* → /contact (301 permanent, suppression du paramètre lang)
RewriteCond %{QUERY_STRING} ^lang= [NC]
RewriteCond %{REQUEST_URI} ^/contact [NC]
RewriteRule ^contact$ /contact? [R=301,L]

# ============================================================================
# BLOC 4 : SUPPRESSION DU TRAILING SLASH (sauf dossiers physiques)
# /fr/FR/ → /fr/FR (301)
# ============================================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$ [NC]
RewriteRule ^ %1 [R=301,L]

# ============================================================================
# BLOC 5 : RÉÉCRITURE DES URLs PROPRES → index.php (sans redirection)
# /en/US → index.php?lang=en&country=US
# ============================================================================

# CRITIQUE: Forcer index.php (et non index.html) pour la racine
DirectoryIndex index.php index.html

# Sitemap dynamique : sitemap.xml → sitemap.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Réécriture /lang/COUNTRY → index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z]{2})/([A-Z]{2})$ index.php?lang=$1&country=$2 [L,QSA]

# Réécriture /lang → index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z]{2})$ index.php?lang=$1 [L,QSA]

# Réécriture /contact → contact.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^contact$ contact.php [L,QSA]

# ============================================================================
# COMPRESSION GZIP
# ============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ============================================================================
# CACHE DES FICHIERS STATIQUES
# ============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ============================================================================
# SÉCURITÉ
# ============================================================================
<FilesMatch "^(\.htaccess|\.git|composer\.json|composer\.lock|package\.json|package-lock\.json|twa-manifest\.json|android\.keystore|gradle\.properties)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/config/
RedirectMatch 403 ^/\.git/
RedirectMatch 403 ^/logs/

Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

